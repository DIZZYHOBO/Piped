#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression --message="Backing up Piped..."

# Built artifacts can be reproduced from upstream — only back up what's expensive
# to lose: the rendered frontend (in case upstream is unavailable), the backend
# JAR + config, the proxy binary, and the persistent data dir.
# Helpers v2.1 takes the path as a positional argument (no --src_path).
ynh_backup "${install_dir}/dist"
ynh_backup "${install_dir}/backend"
ynh_backup "${install_dir}/piped-proxy"
ynh_backup "$data_dir"

# nginx + systemd configs.
ynh_backup "/etc/nginx/conf.d/${domain}.d/${app}.conf"
ynh_backup "/etc/systemd/system/${app}-backend.service"
ynh_backup "/etc/systemd/system/${app}-proxy.service"

# PostgreSQL dump (lands in db.sql in the backup archive).
ynh_psql_dump_db > "db.sql"
