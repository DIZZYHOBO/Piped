#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression --message="Removing Piped..."

# Stop and unregister services.
if ynh_hide_warnings yunohost service status "${app}-backend" >/dev/null 2>&1; then
    yunohost service remove "${app}-backend"
fi
if ynh_hide_warnings yunohost service status "${app}-proxy" >/dev/null 2>&1; then
    yunohost service remove "${app}-proxy"
fi

ynh_config_remove_systemd --service="${app}-backend"
ynh_config_remove_systemd --service="${app}-proxy"
ynh_config_remove_nginx

# Logs
rm -rf "/var/log/${app}"

# Adoptium / NodeSource APT lists are intentionally NOT removed — other apps may use them.

ynh_script_progression --message="Piped removed."
